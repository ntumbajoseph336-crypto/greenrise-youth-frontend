{
  "routes": [
    { "handle": "filesystem" },
    {
      "src": "^/api/(.*)$",
      "dest": "https://greenrise-test.lovestoblog.com/greenrise-api/backend/api/$1"
    },
    {
      "src": "^/greenrise-api/backend/api/(.*)$",
      "dest": "https://greenrise-test.lovestoblog.com/greenrise-api/backend/api/$1"
    },
    { "src": "^/(.*)$", "dest": "/index.html" }
  ]
}
